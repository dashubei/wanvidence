---
/**
 * エビデンス強度バッジ。
 *
 * 設計上の原則:
 *   色だけで意味を伝えない。必ず「アイコン + 日本語ラベル」を同時に表示する。
 *   （色覚特性・モノクロ印刷・低コントラスト環境でも判別できるようにするため）
 */
import ShieldCheck from '@lucide/astro/icons/shield-check';
import CircleDot from '@lucide/astro/icons/circle-dot';
import CircleDashed from '@lucide/astro/icons/circle-dashed';
import MessageSquareQuote from '@lucide/astro/icons/message-square-quote';
import Scale from '@lucide/astro/icons/scale';

export type EvidenceLevel = 'strong' | 'moderate' | 'weak' | 'experience' | 'disputed';

interface Props {
  level: EvidenceLevel;
  /** 補足情報。例: "n=3,432 / 2019年" */
  note?: string;
  class?: string;
}

const { level, note, class: className } = Astro.props;

const MAP = {
  strong: {
    label: '強い根拠',
    Icon: ShieldCheck,
    desc: '系統的レビュー・メタ分析・ランダム化比較試験・大規模コホート研究に基づく',
  },
  moderate: {
    label: '中程度の根拠',
    Icon: CircleDot,
    desc: '単一の観察研究や中規模の調査に基づく',
  },
  weak: {
    label: '弱い根拠',
    Icon: CircleDashed,
    desc: '専門家の意見・小規模研究・症例報告・仕組みからの推論',
  },
  experience: {
    label: '体験談',
    Icon: MessageSquareQuote,
    desc: '個人の記録。科学的根拠ではなく、実際にこう語られているという事実',
  },
  disputed: {
    label: '論争中',
    Icon: Scale,
    desc: '研究の結果が割れている、または日本と海外で指針が異なる',
  },
} as const;

const { label, Icon, desc } = MAP[level];
---

<span class:list={['ev', `ev--${level}`, className]} title={desc}>
  <Icon size={13} stroke-width={2.4} aria-hidden="true" class="ev__icon" />
  <span class="ev__label">{label}</span>
  {note && <span class="ev__note">{note}</span>}
</span>

<style>
  .ev {
    display: inline-flex;
    /* baseline にする理由: note が折り返すとバッジは複数行の高さになる。
       center だとアイコンとラベルが箱の中央（＝2行目あたり）に浮いてしまうので、
       1行目のベースラインに揃える。1行しかないときの見た目は従来とほぼ同じ。 */
    align-items: baseline;
    gap: 0.3em;
    max-inline-size: 100%;
    padding: 0.12em 0.55em 0.16em;
    border: 1px solid var(--tint-border);
    /* 1行分の高さ（約 23px）の半分。1行なら従来どおり完全な pill に見え、
       note が折り返して数行になったときは角丸の箱として成立する。
       999px のままだと、複数行になった瞬間に両端が極端に丸い形になる。 */
    border-radius: 0.72rem;
    background: var(--tint-soft);
    color: var(--tint);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.5;
    vertical-align: 0.08em;
    cursor: help;
  }
  .ev__icon { flex: none; }
  /* ラベル（「強い根拠」など）だけは絶対に折り返さない。
     バッジ全体に white-space: nowrap を掛けると、note が長いときに
     モバイルで数百px はみ出して横スクロールが出る（実測で最大 614px）。 */
  .ev__label { white-space: nowrap; }
  .ev__note {
    /* flex アイテムの min-width は auto なので、指定しないと
       「これ以上縮まない幅」が残って親からはみ出す。 */
    min-inline-size: 0;
    padding-inline-start: 0.4em;
    border-inline-start: 1px solid var(--tint-border);
    font-weight: 400;
    font-variant-numeric: tabular-nums;
    /* 出典注記には DOI・英語の誌名など、区切りのない長い語が入る */
    overflow-wrap: anywhere;
  }
  .ev--strong     { --tint: var(--c-ev-strong);   --tint-soft: var(--c-ev-strong-soft);   --tint-border: var(--c-ev-strong-border); }
  .ev--moderate   { --tint: var(--c-ev-moderate); --tint-soft: var(--c-ev-moderate-soft); --tint-border: var(--c-ev-moderate-border); }
  .ev--weak       { --tint: var(--c-ev-weak);     --tint-soft: var(--c-ev-weak-soft);     --tint-border: var(--c-ev-weak-border); }
  .ev--experience { --tint: var(--c-ev-exp);      --tint-soft: var(--c-ev-exp-soft);      --tint-border: var(--c-ev-exp-border); }
  .ev--disputed   { --tint: var(--c-ev-disputed); --tint-soft: var(--c-ev-disputed-soft); --tint-border: var(--c-ev-disputed-border); }
</style>
