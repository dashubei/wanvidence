---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchIcon from '@lucide/astro/icons/search';

// 末尾のスラッシュを落とす。'/' のときは空文字になり、base なしの配信と同じパスになる。
const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
---

<!-- noindex にする理由: 検索フォーム自体には読む内容が無く、索引に入れても
     検索結果を1つ潰すだけになる。robots.txt では拒否していない（拒否すると
     ページが読まれず、この noindex も読まれないため）。 -->
<BaseLayout title="検索" description="本文を全文検索する" noindex>
  <main id="main" class="wrap">
    <h1 class="ttl">検索</h1>

    <form class="sf" role="search" onsubmit="return false;">
      <label class="sr-only" for="q">本文を検索</label>
      <SearchIcon size={18} stroke-width={2.2} aria-hidden="true" class="sf__icon" />
      <input
        id="q"
        type="search"
        class="sf__input"
        placeholder="調べたい言葉を入力（例: 甘噛み、ワクチン、費用）"
        autocomplete="off"
        autofocus
      />
    </form>

    <p class="status" data-status aria-live="polite"></p>
    <div class="results" data-results></div>
  </main>

  <!--
    この script は is:inline にしている（＝Astro / Vite に一切触らせない）。

    通常の <script> にすると Vite が動的 import を
      __vitePreload(() => import(x), __VITE_PRELOAD__)
    に包み、__VITE_PRELOAD__ を後段で依存配列に差し替える。
    ところが Astro が生成された chunk を HTML に直接埋め込む経路（小さい script は
    外部ファイルにせず inline される）に入ると差し替えが走らず、
    __VITE_PRELOAD__ という未定義の識別子がそのまま出力される。
    実行時に ReferenceError になり、下の try/catch が
    「検索インデックスが見つかりません」を表示していた（索引自体は正常に生成されている）。

    /* @vite-ignore */ を付けても vite.build.modulePreload を false にしても包むのは止まらない。
    ページが増えて chunk が共有されると外部ファイル化して直る、という
    再現条件の分かりにくい壊れ方をするので、Vite の変換自体を通さないことにした。
    base は define:vars で渡す（is:inline では import.meta.env が置換されないため）。

    副作用: `pnpm typecheck` が ts(7027) "Unreachable code detected" を hint 1件出す。
    astro check が is:inline の中身をコンポーネント関数の return より後ろに置くための
    見かけ上のもので、error ではない（終了コードは 0 のまま）。追いかけなくてよい。
  -->
  <script is:inline define:vars={{ base }}>
    const input = document.querySelector('#q');
    const status = document.querySelector('[data-status]');
    const out = document.querySelector('[data-results]');

    let pagefind = null;
    let loadFailed = false;

    // ベースパス配下（GitHub Pages のプロジェクトサイト）で配信されるときの2点。
    // どちらも入れないと検索が黙って壊れる。
    //   1. バンドルの場所。import した URL から自動検出されるので、base 付きで import する
    //   2. 検索結果の URL。pagefind が索引を作るのは dist/ の中なので、生成される URL は
    //      `/chapters/...` と base なしになる。baseUrl で前に付け足して補う
    // base なしのローカル閲覧では空文字なので、従来と同じパスになる。
    const ensurePagefind = async () => {
      if (pagefind || loadFailed) return pagefind;
      try {
        // 検索インデックスはビルド時に生成される。
        // 開発サーバー（pnpm dev）では存在しないため、その場合はここで失敗する。
        pagefind = await import(`${base}/pagefind/pagefind.js`);
        await pagefind.options({ baseUrl: `${base}/` });
        await pagefind.init();
      } catch {
        loadFailed = true;
        if (status) {
          status.textContent =
            '検索インデックスが見つかりません。pnpm start でビルドしてから開いてください（開発サーバーでは検索は動きません）。';
        }
      }
      return pagefind;
    };

    const escapeHtml = (s) =>
      s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c] ?? c,
      );

    let seq = 0;
    const run = async (query) => {
      const mine = ++seq;
      if (!out || !status) return;

      if (query.trim().length === 0) {
        out.innerHTML = '';
        status.textContent = '';
        return;
      }

      const pf = await ensurePagefind();
      if (!pf) return;

      status.textContent = '検索中…';
      const search = await pf.search(query);
      if (mine !== seq) return; // より新しい入力が来ていたら破棄

      const results = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
      if (mine !== seq) return;

      status.textContent =
        search.results.length === 0
          ? '見つかりませんでした。別の言い方（例: 「予防接種」→「ワクチン」）も試してください。'
          : `${search.results.length} 件見つかりました`;
      out.innerHTML = results
        .map(
          (r) => `
        <a class="rs" href="${escapeHtml(r.url)}">
          <span class="rs__title">${escapeHtml(r.meta?.title ?? '(無題)')}</span>
          <span class="rs__excerpt">${r.excerpt}</span>
        </a>`,
        )
        .join('');
    };

    let timer;
    input?.addEventListener('input', () => {
      window.clearTimeout(timer);
      timer = window.setTimeout(() => run(input.value), 180);
    });
  </script>

  <style>
    .wrap {
      max-inline-size: 52rem;
      margin-inline: auto;
      padding: clamp(1.5rem, 4vw, 3rem) clamp(0.9rem, 4vw, 2.5rem) 0;
    }
    .ttl { margin: 0 0 1.2rem; font-size: 1.6rem; font-weight: 700; }
    .sf {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.7rem 0.95rem;
      border: 1px solid var(--c-border-strong);
      border-radius: 0.6rem;
      background: var(--c-surface);
    }
    .sf:focus-within { border-color: var(--c-accent); }
    .sf__icon { flex: none; color: var(--c-text-faint); }
    .sf__input {
      flex: 1;
      min-inline-size: 0;
      border: 0;
      background: none;
      color: var(--c-text);
      font: inherit;
      font-size: 1rem;
    }
    .sf__input:focus { outline: none; }
    .status {
      margin: 0.9rem 0 0;
      color: var(--c-text-muted);
      font-size: 0.8125rem;
    }
    .results { margin-block-start: 1rem; display: grid; gap: 0.6rem; }
    .results :global(.rs) {
      display: block;
      padding: 0.85rem 1rem;
      border: 1px solid var(--c-border);
      border-radius: 0.5rem;
      background: var(--c-surface);
      color: var(--c-text);
      text-decoration: none;
    }
    .results :global(.rs:hover) { border-color: var(--c-accent-line); background: var(--c-accent-soft); }
    .results :global(.rs__title) {
      display: block;
      margin-block-end: 0.25rem;
      font-size: 0.9375rem;
      font-weight: 700;
      color: var(--c-accent);
    }
    .results :global(.rs__excerpt) {
      display: block;
      font-size: 0.875rem;
      line-height: 1.75;
      color: var(--c-text-muted);
    }
    .results :global(mark) {
      background: var(--c-ev-disputed-soft);
      color: var(--c-text);
      font-weight: 700;
      border-radius: 2px;
      padding-inline: 0.1em;
    }
  </style>
</BaseLayout>
